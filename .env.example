# Agnes API endpoint
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Default model
AGNES_MODEL=agnes-2.0-flash

# API key — DO NOT commit a real value here.
# Inject at runtime via PowerShell:
#   $env:AGNES_API_KEY = "sk-..."
# AGNES_API_KEY=
# AGNES_TOTAL_TIMEOUT_SECONDS=90
# AGENS_MODEL_BASE_URL_ALLOWLIST=models.example.com

# Database is PostgreSQL-only (local + production). Inject DATABASE_URL at
# runtime; do not commit real credentials.
# DATABASE_URL=postgresql://agens_user:CHANGE_ME@localhost:5432/agens_web

# Invite-only auth for external deployment.
# SESSION_SECRET=CHANGE_ME
# SESSION_COOKIE_SECURE=0
# INVITE_ADMIN_CODE=CHANGE_ME
# MODEL_CONFIG_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AGENS_GUEST_SESSION_TTL_SECONDS=86400
