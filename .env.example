# Agnes API endpoint
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Default model
AGNES_MODEL=agnes-2.0-flash

# API key — DO NOT commit a real value here.
# Inject at runtime via PowerShell:
#   $env:AGNES_API_KEY = "sk-..."
# AGNES_API_KEY=

# Optional SQLite path for the Web backend.
# AGENS_WEB_DB=runtime/web/agens_web.sqlite3

# Production database is injected at runtime; do not commit real credentials.
# DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://agens_user:CHANGE_ME@postgres:5432/agens_web

# Invite-only auth for external deployment.
# SESSION_SECRET=CHANGE_ME
# SESSION_COOKIE_SECURE=0
# INVITE_ADMIN_CODE=CHANGE_ME
